{
  "name": "@ian-pascoe/dotfiles-chezmoi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check-nvim": "bash dot_themes/tools/check-nvim.sh",
    "hunk-themes": "bash dot_themes/tools/hunk-themes.sh",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "new-variant": "node dot_themes/tools/new-variant.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && vp run --filter '!@ian-pascoe/dotfiles-chezmoi' typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "ignore"
    }
  }
}
