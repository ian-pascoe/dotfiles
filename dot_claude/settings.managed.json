{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "availableModels": ["fable", "opus", "sonnet", "haiku"],
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/format-edited-file.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lsp@dotfiles": true
  }
}
