#!/bin/sh
# Manage only the keys in settings.managed.json (herdr's keys and options);
# the rest of settings.json is Tern state written from its Settings page.
# keybinds is replaced whole, so herdr's table stays the source of truth.
set -eu

input=$(cat)
[ -n "$input" ] || input='{}'
printf '%s\n' "$input" |
  jq --slurpfile managed "$CHEZMOI_SOURCE_DIR/Library/private_Application Support/private_Tern/settings.managed.json" \
    '. + $managed[0]'
