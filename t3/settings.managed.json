{
  "defaultAutoPull": true,
  "worktreesDirectory": "~/.worktrees",
  "fastWorktreeCheckout": true,
  "storageCleanup": {
    "worktreeAfterDays": 8,
    "worktreeSettledAfterDays": 8,
    "worktreeOnMerge": true,
    "worktreeOnDelete": true,
    "browserArtifactsAfterDays": 14,
    "logsAfterDays": 7
  },
  "idleCompaction": "onReturn",
  "promptSuggestionsEnabled": true,
  "linkedEnvironmentsEnabled": true,
  "addProjectBaseDirectory": "~/src",
  "branchNamingMode": "semantic",
  "removeAgentCreditsOnMerge": true,
  "sourceControlWritingStyle": {
    "mode": "conventional_commits"
  },
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-opus-5-5",
    "options": [
      {
        "id": "effort",
        "value": "high"
      }
    ]
  },
  "textGenerationModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-haiku-5-5",
    "options": [
      {
        "id": "effort",
        "value": "low"
      }
    ]
  },
  "providerInstances": {
    "claudeAgent": {
      "driver": "claudeAgent",
      "enabled": true
    },
    "antigravity": {
      "driver": "antigravity",
      "enabled": true
    },
    "codex": {
      "driver": "codex",
      "enabled": false
    },
    "grok": {
      "driver": "grok",
      "enabled": false
    },
    "opencode": {
      "driver": "opencode",
      "enabled": false
    },
    "pi": {
      "driver": "pi",
      "displayName": "Pi",
      "enabled": true,
      "config": {
        "binaryPath": "pi-t3"
      }
    }
  }
}
