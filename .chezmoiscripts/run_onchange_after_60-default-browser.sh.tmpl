{{- /* Renders empty until Zen and the setter are installed, so a later apply
       runs it once they are. Windows is left out: it guards the default
       browser against scripted changes. */ -}}
{{- $zenDesktop := joinPath .chezmoi.homeDir ".local/share/applications/zen.desktop" -}}
{{ if and (eq .chezmoi.os "darwin") (stat "/Applications/Zen.app") (lookPath "defaultbrowser") -}}
#!/bin/sh
# Make Zen the default browser. macOS asks once to confirm the change;
# defaultbrowser does nothing when Zen is already the default.
set -eu
{{ lookPath "defaultbrowser" | quote }} zen
{{ else if and (eq .chezmoi.os "linux") (stat $zenDesktop) (lookPath "xdg-settings") -}}
#!/bin/sh
# Make Zen the default browser. zen.desktop comes from Zen's tarball install
# (see docs/package-ownership.md in the chezmoi source).
set -eu
if [ "$(xdg-settings get default-web-browser 2>/dev/null || true)" != zen.desktop ]; then
  xdg-settings set default-web-browser zen.desktop
fi
{{ end -}}
