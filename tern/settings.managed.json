{
  "agent_command": "pi",
  "code_font": "GeistMono Nerd Font",
  "font_family": "GeistMono Nerd Font",
  "font_family_bold": "GeistMono Nerd Font ",
  "font_family_bold_italic": "GeistMono Nerd Font",
  "font_family_italic": "GeistMono Nerd Font",
  "font_size": 11,
  "keybinds": {
    "ctrl+insert": "edit.copy",
    "shift+insert": "edit.paste",
    "ctrl+space>q": "reload_config",
    "ctrl+space>shift+/": "palette",
    "ctrl+space>shift+s": "preferences",
    "ctrl+space>d": "quit",
    "ctrl+space>b": "toggle_sidebar",

    "ctrl+space>ctrl+left": "resize_split:left",
    "ctrl+space>ctrl+down": "resize_split:down",
    "ctrl+space>ctrl+up": "resize_split:up",
    "ctrl+space>ctrl+right": "resize_split:right",

    "alt+p": "previous_tab",
    "alt+n": "next_tab",
    "alt+shift+p": "plugin.herdr.previous_session",
    "alt+shift+n": "plugin.herdr.next_session",

    "ctrl+space>space": "switch_session",
    "ctrl+space>alt+g": "plugin.herdr.goto",
    "ctrl+space>shift+c": "new_session",
    "ctrl+space>shift+r": "rename_session",
    "ctrl+space>shift+k": "close_session",
    "ctrl+space>shift+p": "plugin.herdr.previous_session",
    "ctrl+space>shift+n": "plugin.herdr.next_session",
    "ctrl+space>shift+1": "plugin.herdr.goto_session_1",
    "ctrl+space>shift+2": "plugin.herdr.goto_session_2",
    "ctrl+space>shift+3": "plugin.herdr.goto_session_3",
    "ctrl+space>shift+4": "plugin.herdr.goto_session_4",
    "ctrl+space>shift+5": "plugin.herdr.goto_session_5",
    "ctrl+space>shift+6": "plugin.herdr.goto_session_6",
    "ctrl+space>shift+7": "plugin.herdr.goto_session_7",
    "ctrl+space>shift+8": "plugin.herdr.goto_session_8",
    "ctrl+space>shift+9": "plugin.herdr.goto_session_9",
    "ctrl+space>shift+g": "plugin.worktrees.new",
    "ctrl+space>shift+w": "plugin.worktrees.open",
    "ctrl+space>alt+w": "plugin.worktrees.remove",
    "ctrl+space>shift+o": "plugin.layouts.dev",
    "ctrl+space>w": "new_browser_block",

    "ctrl+space>c": "new_tab",
    "ctrl+space>,": "rename_tab",
    "ctrl+space>p": "previous_tab",
    "ctrl+space>n": "next_tab",
    "ctrl+space>shift+x": "close_tab",
    "ctrl+space>1": "goto_tab:1",
    "ctrl+space>2": "goto_tab:2",
    "ctrl+space>3": "goto_tab:3",
    "ctrl+space>4": "goto_tab:4",
    "ctrl+space>5": "goto_tab:5",
    "ctrl+space>6": "goto_tab:6",
    "ctrl+space>7": "goto_tab:7",
    "ctrl+space>8": "goto_tab:8",
    "ctrl+space>9": "goto_tab:9",

    "ctrl+space>e": "open_scrollback",
    "ctrl+space>v": "split_right",
    "ctrl+space>s": "split_down",
    "ctrl+space>x": "close_pane",
    "ctrl+space>z": "zoom",

    "ctrl+space>g": "plugin.herdr.lazygit",
    "ctrl+space>f": "files",
    "ctrl+space>shift+f": "open_file",

    "ctrl+space>a": "plugin.annotate.capture",
    "ctrl+space>shift+a": "plugin.annotate.copy_context",
    "ctrl+space>ctrl+a": "plugin.annotate.copy_archive",
    "ctrl+space>m": "plugin.annotate.manage",

    "ctrl+h": "plugin.herdr.navigate_left",
    "ctrl+j": "plugin.herdr.navigate_down",
    "ctrl+k": "plugin.herdr.navigate_up",
    "ctrl+l": "plugin.herdr.navigate_right",
    "ctrl+space>ctrl+l": "text:\\x0c"
  },
  "keymap": "tmux",
  "keymap_prefix": "ctrl+space",
  "opacity": 75,
  "pane_headers": "Split",
  "tabs": "Vertical",
  "tabs_autohide": true,
  "theme": "System",
  "theme_dark": "current",
  "theme_light": "current",
  "ui_font": "Geist"
}
