#!/usr/bin/env bash
# Sets a random theme family on every machine, in this machine's saved mode;
# see set-theme-all. Options such as -n/--dry-run pass through to it.

theme=$(list-themes | shuf -n 1)
if [[ -z $theme ]]; then
  echo "No themes found in ~/.themes" >&2
  exit 1
fi

exec set-theme-all "$@" "$theme"
