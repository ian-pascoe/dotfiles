#!/usr/bin/env bash
# Switches the current theme: resolves a theme family or variant name (see
# theme-resolve), points ~/.config/theme at ~/.themes/<variant>, then tells
# running apps to reload. Every app's theme link goes through ~/.config/theme
# and is managed by chezmoi, so nothing else is relinked here.
#   set-theme <family|variant> [light|dark]
# A family name uses the saved mode unless a mode is given. The mode is saved
# when one is given or a variant name is used; a family with no variant in the
# wanted mode falls back to its only variant and keeps the saved mode. On macOS
# the system appearance follows the variant used: light with a light.mode file.
# Tern, Neovim and WezTerm watch the link themselves; k9s, yazi and pi/omp
# pick the theme up on their next start. Rex imports the variant's Ghostty
# colors when it is running. helium-theme updates Helium's theme:
# live on macOS, at Helium's next start on Linux.
# In WSL the Windows host follows: its Set-Theme.ps1 runs with the variant and
# leaves WSL alone. When the switch starts on Windows, Set-Theme.ps1 runs this
# script with THEME_FROM_WINDOWS set, so it does not run back.

if [ -z "$1" ]; then
  echo "Usage: $0 <family|variant> [light|dark]"
  exit 1
fi

THEMES_DIR="$HOME/.themes"
CURRENT_THEME_DIR="$HOME/.config/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
MODE="${2:-}"

SAVED_MODE=$(theme-resolve --mode)
WANTED_MODE="${MODE:-$SAVED_MODE}"

# Errors for unknown names and modes come from theme-resolve.
THEME_VARIANT=$(theme-resolve "$THEME_NAME" "$WANTED_MODE") || exit 1
THEME_PATH="$THEMES_DIR/$THEME_VARIANT"
VARIANT_MODE=$(theme-resolve --mode-of "$THEME_VARIANT")

if ! theme-resolve --is-family "$THEME_NAME"; then
  # A variant name decides the mode itself.
  if [[ -n $MODE && $MODE != "$VARIANT_MODE" ]]; then
    echo "$THEME_VARIANT is a $VARIANT_MODE variant; ignoring mode $MODE" >&2
  fi
  NEW_MODE=$VARIANT_MODE
elif [[ $VARIANT_MODE == "$WANTED_MODE" ]]; then
  NEW_MODE=$WANTED_MODE
else
  echo "$THEME_NAME has no $WANTED_MODE variant; using $THEME_VARIANT and keeping mode $SAVED_MODE"
  NEW_MODE=$SAVED_MODE
fi
[[ $NEW_MODE != "$SAVED_MODE" ]] && theme-resolve --save-mode "$NEW_MODE"

echo "Linking new theme: $THEME_VARIANT"
ln -snf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Set the appearance before apps reload so they pick up the new mode.
if [[ "$OSTYPE" == "darwin"* ]]; then
  if [[ $VARIANT_MODE == light ]]; then
    dark_mode=false
  else
    dark_mode=true
  fi
  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark_mode"
fi

# bat reads themes from its cache
bat cache --build >/dev/null

# Ghostty and btop reload their config on SIGUSR2 (herdr follows Ghostty's colors)
pkill -USR2 -x ghostty 2>/dev/null
pkill -USR2 -x btop 2>/dev/null

# Rex imports the variant's Ghostty colors through the sync_theme action in
# ~/.config/rex/init.lua; Rex.app accepts it only with Remote Control on.
if [[ "$OSTYPE" == "darwin"* ]]; then
  rex_bin="${REX_BIN_DIR:-$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS}/rex"
  if [[ -x $rex_bin ]]; then
    "$rex_bin" --autostart=false "do" sync_theme >/dev/null 2>&1
    # Status 4: no Rex server is running, so there is nothing to update.
    case $? in
    0 | 4) ;;
    *) echo "Rex theme not synced (turn on Remote Control in Rex's Settings)" >&2 ;;
    esac
  fi
fi

# Helium loads its theme from a copy that helium-theme keeps
command -v helium-theme >/dev/null && helium-theme

set-bg 1

if [[ "$OSTYPE" == "darwin"* ]]; then
  brew services restart borders
fi

if [[ -n ${WSL_DISTRO_NAME:-} && -z ${THEME_FROM_WINDOWS:-} ]] && command -v pwsh.exe >/dev/null; then
  echo "Setting the Windows host's theme"
  if ! pwsh.exe -NoProfile -NonInteractive -Command \
    "& (Join-Path \$env:USERPROFILE '.local\bin\Set-Theme.ps1') -ThemeName '$THEME_VARIANT' -SkipWsl"; then
    echo "Setting the Windows host's theme failed" >&2
    exit 1
  fi
fi
