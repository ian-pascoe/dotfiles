#!/usr/bin/env bash
# Switches the current theme: points ~/.config/theme at ~/.themes/<name>, then
# tells running apps to reload. Every app's theme link goes through
# ~/.config/theme and is managed by chezmoi, so nothing else is relinked here.
# Tern and Neovim watch the link themselves; k9s, yazi and pi/omp pick the
# theme up on their next start.

if [ -z "$1" ]; then
  echo "Usage: $0 <theme-name>"
  exit 1
fi

THEMES_DIR="$HOME/.themes"
CURRENT_THEME_DIR="$HOME/.config/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR"
  exit 1
fi

echo "Linking new theme: $THEME_NAME"
ln -snf "$THEME_PATH" "$CURRENT_THEME_DIR"

# bat reads themes from its cache
bat cache --build >/dev/null

# Ghostty and btop reload their config on SIGUSR2 (herdr follows Ghostty's colors)
pkill -USR2 -x ghostty 2>/dev/null
pkill -USR2 -x btop 2>/dev/null

set-bg 1

if [[ "$OSTYPE" == "darwin"* ]]; then
  brew services restart borders
fi
