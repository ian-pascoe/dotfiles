#!/usr/bin/env bash
# plannotator-tui's Herdr review pane, in the Herdr desktop app: herdr-annotate's
# document and agent-reply review, with the feedback sent straight to the
# agent's terminal.
#
# Usage:
#   herdr-app-plannotator open [PATH] [--gate] [--result-file PATH]   (agents)
#   herdr-app-plannotator review --target TERMINAL [...]              (the popup)
#
# The app's terminals are herdr-core's, so a target is an hc address (t7).
# `review` runs plannotator-tui's Herdr pane entrypoint with HERDR_BIN_PATH
# pointing back here, so the herdr commands it runs (agent prompt, pane get,
# pane read, agent read) are answered with hc. That is plannotator-tui's
# internal herdr contract, as of plannotator-tui 0.9.9; a newer release may
# change it. `open` shows the review in a popup over the app, with
# herdr-app-popup.
set -u

hc_bin=${HC_BIN:-hc}

hc() { command "$hc_bin" "$@"; }

self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

# Leaves the message on screen: a popup closes when its command exits.
die() {
  printf '\n%s\n\n' "$*" >&2
  [[ -t 0 ]] && read -rsn1 -p "Press any key to close"
  exit 1
}

# Fails the way herdr does: a JSON envelope on stderr, whose code
# plannotator-tui maps to "blocked" (retry later) or "unavailable".
herdr_error() { # code message
  jq -nc --arg code "$1" --arg message "$2" '{error: {code: $code, message: $message}}' >&2
  exit 1
}

# For a flag's argument loop: dies unless the flag ($1) has a value ($2).
need_value() {
  [[ $# -ge 2 && -n $2 ]] || die "$1 needs a value"
}

absolute() { # path
  if [[ $1 == /* ]]; then printf '%s' "$1"; else printf '%s/%s' "$PWD" "$1"; fi
}

# plannotator-tui's host label for the agent a program or 7501 app name names,
# or failure for a program whose transcripts it can't read.
host_label() { # name
  local name
  name=$(tr '[:upper:]' '[:lower:]' <<<"${1##*/}")
  case $name in
  claude | claude-code | "claude code") echo claude ;;
  codex | pi | omp | copilot | droid | hermes | opencode | cmd | agy) echo "$name" ;;
  *) return 1 ;;
  esac
}

# Reads the agent in terminal into $agent (its host label when plannotator-tui
# knows it, else the app name it reports), $agent_pid and $agent_cwd, and
# whether it waits at a prompt into $agent_blocked. Returns 1 when the
# terminal doesn't exist, 2 when no agent runs in it.
#
# An agent is a program that reports its status over OSC 7501 (shells and
# editors report none), or a foreground process plannotator-tui knows by name.
read_agent() { # terminal
  local terminal app process_name
  agent='' agent_pid='' agent_cwd='' agent_blocked=''
  [[ -n $1 ]] || return 1
  terminal=$(hc get "$1" --json 2>/dev/null) || return 1
  # status is the root 7501 record; records holds any others it reports.
  {
    read -r app
    read -r process_name
    read -r agent_pid
    read -r agent_cwd
    read -r agent_blocked
  } < <(jq -r '
    (.status | if type == "object" then . elif type == "string" then {state: .} else {} end) as $s
    | $s.app, .foreground.name, .foreground.pid, (.foreground.cwd // .cwd),
      (if any($s, (.records // {})[]; .state == "blocked") then 1 else null end)
    | . // ""' <<<"$terminal")
  if [[ -n $app ]]; then
    agent=$(host_label "$app") || agent=$app
  elif ! agent=$(host_label "$process_name"); then
    agent='' agent_pid=''
    return 2
  fi
}

# herdr's `agent prompt`: the feedback as the agent's next message. hc send
# pastes it in one piece (bracketed when the agent takes it), then Enter.
agent_prompt() { # terminal text
  local terminal=${1:-} text error
  [[ -n $terminal && -n ${2:-} ]] || herdr_error empty_agent_prompt "agent prompt needs a pane and text"
  read_agent "$terminal"
  case $? in
  1) herdr_error pane_not_found "pane $terminal not found" ;;
  2) herdr_error agent_not_found "no agent runs in pane $terminal" ;;
  esac
  [[ -n $agent_blocked ]] && herdr_error agent_blocked "the agent in $terminal is waiting at a prompt"
  # Control characters out, but for line breaks and tabs: quoted terminal text
  # can carry ESC [201~, which would end the paste early.
  text=$(printf '%s' "$2" | LC_ALL=C tr -d '\000-\010\013-\037\177')
  error=$(hc send --json "$terminal" -- "$text" 2>&1 >/dev/null) && return
  # hc refuses a program that went blocked since we looked.
  if [[ $(jq -r '.error.kind? // empty' <<<"$error" 2>/dev/null) == blocked ]]; then
    herdr_error agent_blocked "the agent in $terminal is waiting at a prompt"
  fi
  herdr_error agent_unavailable "hc send to $terminal failed: $error"
}

# herdr's `pane get` envelope, with the agent only when there is one.
pane_get() { # terminal
  read_agent "${1:-}"
  [[ $? == 1 ]] && herdr_error pane_not_found "pane ${1:-} not found"
  jq -nc --arg pane "${1:-}" --arg agent "$agent" \
    '{result: {pane: ({pane_id: $pane} + if $agent != "" then {agent: $agent} else {} end)}}'
}

# herdr's `pane read` and `agent read`: the terminal's last lines, screen and
# history. Only --lines matters; the rest is always the same.
read_output() { # terminal [flags]
  local terminal=${1:-} lines=200 out
  shift
  while (($#)); do
    [[ $1 == --lines && ${2:-} =~ ^[0-9]+$ ]] && lines=$2
    shift
  done
  [[ -n $terminal ]] || exit 1
  # --json: as text, hc adds a note when it could read only the screen.
  out=$(hc read --json "$terminal" --lines "$lines" 2>/dev/null) || exit 1
  out=$(jq -r '.text' <<<"$out") || exit 1
  # $(…) already dropped trailing newlines; drop the blank screen rows above them.
  out=$(sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' <<<"$out")
  tail -n "$lines" <<<"$out"
}

# Runs plannotator-tui's Herdr pane, with the environment herdr-annotate's
# launcher would give it and this script standing in for herdr.
#
# What it opens: --file PATH (default: the folder it runs in), gated with
# --gate; the agent's replies with --last, its newest straight away with
# --newest; the target's recent output with --terminal (--lines N of it).
# Feedback goes to --deliver-to, else to the agent in the target, else to the
# clipboard.
review() { # --target T [--deliver-to T] [--file PATH [--gate [--result-file PATH]] | --last [--newest] | --terminal [--lines N]]
  local target='' deliver_to='' file=$PWD gate='' result_file='' last='' newest='' terminal='' lines=200
  while (($#)); do
    case $1 in
    --target | --deliver-to | --file | --result-file | --lines) need_value "$@" ;;
    esac
    case $1 in
    --target) target=$2 ;;
    --deliver-to) deliver_to=$2 ;;
    --file) file=$(absolute "$2") ;;
    --result-file) result_file=$(absolute "$2") ;;
    --lines) lines=$2 ;;
    --gate) gate=1 ;;
    --last) last=1 ;;
    --newest) last=1 newest=1 ;;
    --terminal) terminal=1 ;;
    *) die "review: unknown argument $1" ;;
    esac
    case $1 in
    --target | --deliver-to | --file | --result-file | --lines) shift ;;
    esac
    shift
  done
  [[ -n $target ]] || die "review: --target is required"
  [[ $lines =~ ^[0-9]+$ ]] || die "--lines must be a number, not $lines"
  read_agent "$target"
  [[ $? == 1 ]] && die "Terminal $target not found."
  if [[ -n $last && -z $agent ]]; then
    die "No agent runs in this terminal, so there are no replies to review."
  fi
  if [[ -z $deliver_to && -n $agent ]]; then
    deliver_to=$target
  fi

  unset "${!HERDR_@}" "${!PLANNOTATOR_TUI_@}"
  export HERDR_ENV=1 HERDR_BIN_PATH=$self
  if [[ -n $terminal ]]; then
    export PLANNOTATOR_TUI_TERMINAL_PANE=$target PLANNOTATOR_TUI_TERMINAL_LINES=$lines
  elif [[ -n $last ]]; then
    export PLANNOTATOR_TUI_HOST=$agent PLANNOTATOR_TUI_CWD=${agent_cwd:-$PWD}
    [[ -n $agent_pid ]] && export PLANNOTATOR_TUI_MESSAGE_PID=$agent_pid
    [[ -n $newest ]] && export PLANNOTATOR_TUI_NEWEST=1
  else
    export PLANNOTATOR_TUI_FILE=$file
    if [[ -n $gate ]]; then
      export PLANNOTATOR_TUI_GATE=1
      [[ -n $result_file ]] && export PLANNOTATOR_TUI_RESULT_FILE=$result_file
    fi
  fi
  if [[ -n $deliver_to ]]; then
    export PLANNOTATOR_TUI_DELIVER_TO=$deliver_to
    [[ $deliver_to == "$target" && -n $agent ]] && export PLANNOTATOR_TUI_DELIVER_AGENT=$agent
  fi
  exec plannotator-tui herdr pane
}

# For agents: review PATH in a popup over the app, the feedback arriving as the
# calling agent's next message.
open_review() { # [PATH] [--gate] [--result-file PATH]
  local path=$PWD args=() dir popup
  [[ -n ${HC_TERMINAL_ID:-} ]] || { echo 'herdr-app-plannotator open: not inside a Herdr app terminal (HC_TERMINAL_ID is unset)' >&2; exit 1; }
  while (($#)); do
    case $1 in
    --gate) args+=(--gate) ;;
    --result-file)
      [[ -n ${2:-} ]] || { echo 'herdr-app-plannotator open: --result-file needs a value' >&2; exit 1; }
      args+=(--result-file "$(absolute "$2")")
      shift
      ;;
    -*) { echo "herdr-app-plannotator open: unknown flag $1" >&2; exit 1; } ;;
    *) path=$(absolute "$1") ;;
    esac
    shift
  done
  [[ -e $path ]] || { echo "herdr-app-plannotator open: $path: no such file or folder" >&2; exit 1; }
  dir=$path
  [[ -d $dir ]] || dir=$(dirname "$path")
  popup=$(command -v herdr-app-popup) || popup=$HOME/.local/bin/herdr-app-popup
  [[ -x $popup ]] || { echo 'herdr-app-plannotator open: herdr-app-popup not found' >&2; exit 1; }
  "$popup" --cwd "$dir" -- "$self" review --target "$HC_TERMINAL_ID" --deliver-to "$HC_TERMINAL_ID" \
    --file "$path" ${args[@]+"${args[@]}"}
}

case "${1:-} ${2:-}" in
"review "*) review "${@:2}" ;;
"open "*) open_review "${@:2}" ;;
"agent prompt") agent_prompt "${@:3}" ;;
"pane get") pane_get "${3:-}" ;;
"pane read" | "agent read") read_output "${@:3}" ;;
*)
  printf 'herdr-app-plannotator: unknown command: %s\n' "$*" >&2
  exit 2
  ;;
esac
