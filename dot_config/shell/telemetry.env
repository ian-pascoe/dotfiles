# Telemetry opt-outs, as plain KEY=VALUE lines (no quotes, no expansion), so one
# file serves every reader:
#   ~/.profile                    sources it with `set -a` (zsh via .zshenv, bash logins)
#   ~/.config/environment.d/      links it for systemd user services (Linux)
#   run_onchange_after_15-telemetry.ps1  copies it into Windows user env vars
# GUI apps launched from the macOS Dock don't see these; their own settings cover
# them (Zed, Claude Code, Hammerspoon, ...). Restart long-running daemons and
# apps (T3 Code, Executor, Syncthing) to pick up a change.

# The convention: Bun (crash uploads), gh, Wrangler, Turbo, Alchemy, skills,
# hunk, impeccable, Plannotator, Executor, T3 Code, Nuxt, Claude Code
DO_NOT_TRACK=1

# Homebrew
HOMEBREW_NO_ANALYTICS=1
# .NET SDK
DOTNET_CLI_TELEMETRY_OPTOUT=1
# PowerShell reads this before its profile runs, hence the Windows user env var
POWERSHELL_TELEMETRY_OPTOUT=1
# GitHub CLI (telemetry on by default since 2.91)
GH_TELEMETRY=false
# Terraform and Prisma (HashiCorp checkpoint)
CHECKPOINT_DISABLE=1
# Cloudflare Wrangler
WRANGLER_SEND_METRICS=false
# Semgrep
SEMGREP_SEND_METRICS=off
# Google Cloud SDK
CLOUDSDK_CORE_DISABLE_USAGE_REPORTING=true
# Pi (install/update ping; settings.managed.json also sets enableInstallTelemetry)
PI_TELEMETRY=0
# T3 Code server
T3CODE_TELEMETRY_ENABLED=false
# Executor
EXECUTOR_DISABLE_ANALYTICS=1
# Claude Code (also set in ~/.claude/settings.json's env for non-shell launches)
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1

# Project frameworks
ASTRO_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
ALCHEMY_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
NUXT_TELEMETRY_DISABLED=1
GATSBY_TELEMETRY_DISABLED=1
STORYBOOK_DISABLE_TELEMETRY=true
NG_CLI_ANALYTICS=false
EXPO_NO_TELEMETRY=1
HF_HUB_DISABLE_TELEMETRY=1
