# Ghostty Config

# dynamic theme
config-file = ?"~/.config/theme/ghostty.conf"

# window
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10
confirm-close-surface = false
quit-after-last-window-closed = true

# background
background-opacity = 0.95

# font
font-family = "GeistMono Nerd Font"
font-style = Regular
font-size = 12

# cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

# keybindings
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# Linux terminal keys on every OS. On macOS AeroSpace owns cmd+t/=/-
# (cmd is Super, the window tier); these are Ghostty's Linux defaults.
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+f=start_search
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Option sends Alt (ESC-prefixed), whatever the keyboard layout, so the
# multiplexers get alt+n/p and alt+shift+n/p. Ghostty binds none of those.
macos-option-as-alt = true
