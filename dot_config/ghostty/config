# Ghostty Config

# dynamic theme
config-file = ?"~/.config/theme/ghostty.conf"

# window
macos-titlebar-style = hidden
window-padding-x = 10
window-padding-y = 10
confirm-close-surface = false
quit-after-last-window-closed = true

# background
background-opacity = 0.95

# font
font-family = "GeistMono Nerd Font"
font-style = Regular
font-size = 12

# cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

# keybindings
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# Linux terminal keys on every OS. On macOS AeroSpace owns cmd+t/=/-
# (SUPER on Omarchy); these are Ghostty's Linux defaults. Tab numbers stay
# unbound so alt+1..9 reaches herdr (Omarchy's preset).
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+f=start_search
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Leave Omarchy's herdr keys to herdr: Ghostty's Linux defaults put tabs on
# alt+1..9 and split focus on ctrl+alt+arrows.
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = ctrl+alt+left=unbind
keybind = ctrl+alt+right=unbind
keybind = ctrl+alt+up=unbind
keybind = ctrl+alt+down=unbind
