{{- /*
  Hex's settings.json with the keys of hex/settings.managed.json, then of
  hex/settings.managed.<os>.json (shortcuts store OS-specific key codes),
  merged in. Objects merge one level deep, so managing a few Labs switches
  keeps the others; anything deeper is replaced whole. The rest is state Hex
  writes: the microphone, recent models, migrations. Go templates can't keep
  key order, so when nothing managed changed, the file is returned untouched
  instead of re-sorted.
*/ -}}
{{- $current := .chezmoi.stdin | trim -}}
{{- $settings := dict -}}
{{- if $current }}{{ $settings = fromJson $current }}{{ end -}}
{{- $before := toJson $settings -}}
{{- $files := list "hex/settings.managed.json" -}}
{{- $osFile := printf "hex/settings.managed.%s.json" .chezmoi.os -}}
{{- if stat (joinPath .chezmoi.sourceDir $osFile) }}{{ $files = append $files $osFile }}{{ end -}}
{{- range $file := $files -}}
{{-   range $key, $value := include $file | fromJson -}}
{{-     $existing := get $settings $key -}}
{{-     if and (kindIs "map" $value) (kindIs "map" $existing) -}}
{{-       range $k, $v := $value }}{{ $_ := set $existing $k $v }}{{ end -}}
{{-     else -}}
{{-       $_ := set $settings $key $value -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if eq $before (toJson $settings) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson $settings -}}
{{- end -}}
