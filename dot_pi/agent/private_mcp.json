{
  "mcpServers": {
    "browser-use": {
      "enabled": true,
      "command": "playwright-mcp",
      "args": ["--output-dir=${HOME}/.cache/playwright-mcp", "--extension"],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${DEFAULT_BROWSER_EXECUTABLE_PATH}",
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      },
      "exposure": "codemode"
    },
    "computer-use": {
      "enabled": true,
      "command": "cua-driver",
      "args": ["mcp"],
      "exposure": "codemode",
      "toolExposure": {
        "browser_*": "hidden",
        "get_browser_state": "hidden",
        "page": "hidden"
      }
    },
    "executor": {
      "enabled": true,
      "url": "https://v2.executor.sh/mcp",
      "exposure": "direct"
    },
    "upsy": {
      "enabled": true,
      "url": "https://upsy.ai/connect",
      "exposure": "codemode"
    },
    "rea": {
      "enabled": true,
      "command": "rea",
      "args": ["mcp"],
      "env": {
        "HOPPER_LAUNCHER_PATH": "/Applications/Hopper Disassembler.app/Contents/MacOS/hopper",
        "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      },
      "exposure": "codemode"
    }
  }
}
