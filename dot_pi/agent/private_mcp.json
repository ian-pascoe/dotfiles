{
  "mcpServers": {
    "executor": {
      "enabled": true,
      "url": "https://mcp.executor.sh/mcp",
      "exposure": "direct"
    },
    "rea": {
      "enabled": true,
      "command": "rea",
      "args": ["mcp"],
      "env": {
        "HOPPER_LAUNCHER_PATH": "/Applications/Hopper Disassembler.app/Contents/MacOS/hopper",
        "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      },
      "exposure": "codemode"
    },
    "superlogical": {
      "enabled": true,
      "url": "https://www.superlogical.com/rex/community-mcp",
      "exposure": "codemode"
    }
  }
}
