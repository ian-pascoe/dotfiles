{
  "mcpServers": {
    "browser-use": {
      "enabled": true,
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest",
        "--extension",
        "--output-dir",
        "/home/ianpascoe/.cache/playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "${DEFAULT_BROWSER_EXECUTABLE_PATH}",
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
        "DISPLAY": ":1",
        "XDG_SESSION_TYPE": "x11"
      },
      "exposure": "deferred"
    },
    "computer-use": {
      "enabled": true,
      "command": "cua-driver",
      "args": ["mcp"],
      "env": {
        "DISPLAY": ":1",
        "XDG_SESSION_TYPE": "x11"
      },
      "exposure": "deferred",
      "toolExposure": {
        "*_agent_cursor_*": "hidden",
        "*_config": "hidden",
        "health_report": "hidden",
        "check_permissions": "hidden",
        "check_for_update": "hidden",
        "install_ffmpeg": "hidden",
        "parallel_mouse_drag": "hidden",
        "mouse_button_*": "hidden"
      }
    },
    "executor": {
      "enabled": true,
      "url": "https://v2.executor.sh/mcp",
      "exposure": "direct"
    },
    "upsy": {
      "enabled": true,
      "url": "https://upsy.ai/connect",
      "exposure": "codemode"
    }
  }
}
