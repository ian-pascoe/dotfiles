      </dict>
      <dict><key>scope</key><string>comment, punctuation.definition.comment</string><key>settings</key><dict><key>foreground</key><string>#8A99A6</string><key>fontStyle</key><string>italic</string></dict></dict>
      <dict><key>scope</key><string>string, punctuation.definition.string</string><key>settings</key><dict><key>foreground</key><string>#D12F1B</string></dict></dict>
